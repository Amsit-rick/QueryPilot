{
  "version": "2026-09-03-v1",
  "datasources": [
    {
      "id": "sqlite-demo",
      "name": "SQLite 演示库",
      "backend": "sqlite",
      "path": "./data/demo.db",
      "readonly": true,
      "roles": [
        "admin",
        "analyst",
        "viewer"
      ]
    },
    {
      "id": "mysql-main",
      "name": "MySQL 生产库",
      "backend": "mysql",
      "readonly": true,
      "allowed_tables": [
        "sales",
        "customers",
        "enterprise_customers",
        "products",
        "enterprise_orders",
        "order_items",
        "inventory",
        "suppliers",
        "employees",
        "payments"
      ],
      "value_columns": [
        "enterprise_orders.status",
        "enterprise_orders.channel",
        "enterprise_customers.industry",
        "enterprise_customers.level",
        "payments.status",
        "payments.method",
        "products.category",
        "inventory.warehouse",
        "employees.department"
      ],
      "roles": [
        "admin",
        "analyst"
      ]
    },
    {
      "id": "postgres-main",
      "name": "PostgreSQL 16 业务库",
      "backend": "postgres",
      "readonly": true,
      "enabled_if_configured": true,
      "allowed_tables": [
        "customers",
        "sales"
      ],
      "roles": [
        "admin",
        "analyst"
      ]
    },
    {
      "id": "oracle-main",
      "name": "Oracle 19c 业务库",
      "backend": "oracle",
      "schema_owner": "QUERYPILOT_OWNER",
      "cost_estimate_enabled": true,
      "readonly": true,
      "enabled_if_configured": true,
      "allowed_tables": [
        "CUSTOMERS",
        "SALES"
      ],
      "roles": [
        "admin",
        "analyst"
      ]
    },
    {
      "id": "sqlserver-main",
      "name": "SQL Server 2022 业务库",
      "backend": "sqlserver",
      "readonly": true,
      "enabled_if_configured": true,
      "allowed_tables": [
        "customers",
        "sales"
      ],
      "roles": [
        "admin",
        "analyst"
      ]
    },
    {
      "id": "clickhouse-main",
      "name": "ClickHouse 24.8 分析库",
      "backend": "clickhouse",
      "readonly": true,
      "enabled_if_configured": true,
      "allowed_tables": [
        "customers",
        "sales"
      ],
      "roles": [
        "admin",
        "analyst"
      ]
    }
  ]
}
