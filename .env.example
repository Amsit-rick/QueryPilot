MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_PROVIDER=direct
DATABASE_PATH=./data/demo.db
MAX_ROWS=1000
QUERY_STREAM_CHUNK_ROWS=100
QUERY_STREAM_HEARTBEAT_SECONDS=5
QUERY_STREAM_STATE_BACKEND=memory
QUERY_STREAM_STATE_TTL_SECONDS=900
QUERY_STREAM_STATE_MAX_EVENTS=2048
QUERY_STREAM_POLL_SECONDS=0.05
CONVERSATION_COMPACTION_THRESHOLD_TURNS=8
CONVERSATION_RECENT_TURNS=4
CONVERSATION_RETRIEVAL_TURNS=2
CONVERSATION_CONTEXT_MAX_CHARS=12000
ANALYSIS_BRANCH_MAX_DEPTH=3
ANALYSIS_BRANCH_MAX_CHILDREN=20
PROACTIVE_ANALYSIS_ENABLED=false
PROACTIVE_ANALYSIS_MIN_INTERVAL_MINUTES=15
PROACTIVE_ANALYSIS_MAX_RUNS_PER_DAY=24
PROACTIVE_ANALYSIS_MAX_DAILY_BUDGET_USD=2.0
PROACTIVE_ANALYSIS_LEASE_SECONDS=120
MODEL_TIMEOUT_SECONDS=30
MAX_SQL_LENGTH=5000
MAX_PARAMS=50
LARGE_RESULT_ROW_THRESHOLD=800
QUERY_COST_GUARD_ENABLED=true
QUERY_COST_REQUIRE_EXPLAIN=false
QUERY_COST_MAX_ESTIMATED_ROWS=100000
QUERY_COST_MAX_ESTIMATED_COST=100000
RELATIONSHIP_APPROVAL_REQUIRED=true
RELATIONSHIP_MIN_CONFIDENCE=0.8
SCHEMA_RETRIEVAL_ENABLED=true
SCHEMA_RETRIEVAL_TABLE_THRESHOLD=50
SCHEMA_RETRIEVAL_MAX_TABLES=20
SCHEMA_RETRIEVAL_MAX_COLUMNS_PER_TABLE=40
SCHEMA_RETRIEVAL_MAX_HOPS=3
SCHEMA_EMBEDDING_PROVIDER=disabled
SCHEMA_EMBEDDING_BASE_URL=
SCHEMA_EMBEDDING_MODEL=
SCHEMA_EMBEDDING_API_KEY_ENV=SCHEMA_EMBEDDING_API_KEY
SCHEMA_EMBEDDING_API_KEY=
SCHEMA_EMBEDDING_TIMEOUT_SECONDS=10
SCHEMA_EMBEDDING_BATCH_SIZE=64
SCHEMA_EMBEDDING_CACHE_ENTRIES=10000
SCHEMA_EMBEDDING_MAX_DOCUMENTS=5000
SCHEMA_EMBEDDING_MAX_DOCUMENT_CHARS=4000
SCHEMA_EMBEDDING_MAX_TOTAL_CHARS=2000000
SCHEMA_EMBEDDING_CACHE_BACKEND=memory
SCHEMA_EMBEDDING_CACHE_TTL_SECONDS=86400
SCHEMA_EMBEDDING_CIRCUIT_BACKEND=memory
SCHEMA_EMBEDDING_CIRCUIT_FAILURES=3
SCHEMA_EMBEDDING_CIRCUIT_RESET_SECONDS=30
SCHEMA_EMBEDDING_REMOTE_ALLOWED=false
# 多 Worker 部署时由启动脚本创建并清空该目录后再设置；单进程本地开发保持为空。
PROMETHEUS_MULTIPROC_DIR=
AUDIT_LOG_PATH=./data/audit.jsonl
AUDIT_LOG_MAX_BYTES=10485760
AUDIT_LOG_BACKUP_COUNT=5
AUDIT_STDOUT_ENABLED=false
CATALOG_PATH=./data/catalog.json
MAX_REQUEST_COST_USD=0.08
DAILY_BUDGET_USD=5.0
BUDGET_BACKEND=memory
COST_PER_1K_TOKENS_USD=0.00014
AUTH_ENABLED=true
API_KEYS=
# Local-only administrator bootstrap. Generated by scripts/setup_local.cmd and
# used by scripts/local_setup.py bootstrap-admin; never valid for production.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=
DATABASE_BACKEND=mysql
DEFAULT_DATASOURCE=mysql-main
START_ALL_DATASOURCES=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=query_agent
MYSQL_USER=query_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_QUERY_USER=query_readonly
MYSQL_QUERY_PASSWORD=
# Bounded PyMySQL connection pool shared by the API, workers and CLI tools.
MYSQL_MAX_CONNECTIONS=10
MYSQL_POOL_IDLE_TTL_SECONDS=300
POSTGRES_DSN=
POSTGRES_READONLY_DSN=
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_SCHEMA_OWNER=
ORACLE_PLAN_USER=
ORACLE_PLAN_PASSWORD=
# Experimental SQL Server connector. SQLSERVER_USER/PASSWORD must be a
# SELECT-only login; SQLSERVER_ADMIN_USER/PASSWORD is only used by
# scripts/provision_sqlserver.py to create the database and that login.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ADMIN_USER=sa
SQLSERVER_ADMIN_PASSWORD=
# Experimental ClickHouse connector. ClickHouse rejects any session setting
# change while readonly=1 is active, so the account itself must be SELECT-only.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Administrative credentials are used only by scripts/provision_clickhouse.py
# to create or migrate the local demo schema. The application never uses them.
CLICKHOUSE_ADMIN_USER=default
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_SECURE=false
JWT_SECRET=
JWT_PREVIOUS_SECRETS=
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
LLM_CIRCUIT_BACKEND=memory
METRICS_TOKEN=
EXPORT_EXECUTION_MODE=inline
EXPORT_MAX_RETRIES=2
REDIS_URL=redis://127.0.0.1:6379/0
MCP_RUNTIME_BACKEND=memory
MCP_QUEUE_TIMEOUT_SECONDS=0.25
MCP_MAX_ARGUMENTS_BYTES=65536
MCP_MAX_RESULT_BYTES=1048576
MCP_MAX_SSE_EVENT_BYTES=1048576
MCP_MAX_DISCOVERED_TOOLS=200
MCP_MAX_TOOL_PAGES=10
AGENT_RUNTIME=langgraph
AGENT_MAX_REPAIRS=2
AGENT_MAX_SCHEMA_EXPANSIONS=1
AGENT_MAX_EXECUTION_RETRIES=1
AGENT_MAX_REFLECTION_STEPS=12
AGENT_REFLECTION_MODE=shadow
AGENT_REFLECTION_LLM_ENABLED=false
AGENT_REFLECTION_CRITIC_TIMEOUT_SECONDS=8
AGENT_REFLECTION_CRITIC_MIN_CONFIDENCE=0.8
AGENT_REFLECTION_EVAL_REPORT_PATH=./artifacts/reflection-eval.json
AGENT_REFLECTION_RELEASE_GATE_PATH=./artifacts/reflection-release-gate.json
AGENT_TRACE_ENABLED=true
AGENT_TRACE_PATH=./data/agent-trace.jsonl
AGENT_TRACE_EXPORTER=jsonl
AGENT_TRACE_OTLP_ENDPOINT=
AGENT_TRACE_OTLP_HEADERS=
AGENT_TRACE_SERVICE_NAME=query-pilot
AGENT_CHECKPOINT_ENABLED=false
AGENT_CHECKPOINT_TTL_SECONDS=3600
AGENT_RECOVERY_LEASE_SECONDS=60
AGENT_LOW_CONFIDENCE_THRESHOLD=0.65
AGENT_HIGH_RISK_ROW_THRESHOLD=5000
MODEL_HTTP_TRUST_ENV=true
